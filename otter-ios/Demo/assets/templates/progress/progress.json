{
  "layout": {
    "type": "column",
    "id": "page",
    "layout": {
      "width": "fill",
      "height": "fill",
      "padding": { "start": 20, "end": 20, "top": 12, "bottom": 8 }
    },
    "style": { "background": "#F3EFE7" },
    "children": [
      { "type": "spacer", "layout": { "width": "fill", "height": 4 } },
      { "type": "text", "text": "PROGRESS", "layout": { "width": "fill", "height": 16 }, "style": { "color": "#C45C26", "fontSize": 12 } },
      { "type": "spacer", "layout": { "width": "fill", "height": 4 } },
      { "type": "text", "text": "进度", "layout": { "width": "fill", "height": 30 }, "style": { "color": "#1F1A17", "fontSize": 22 } },
      { "type": "spacer", "layout": { "width": "fill", "height": 4 } },
      { "type": "text", "text": "from 是起点比例，to 是终点比例，画出来的是这一段。", "layout": { "width": "fill", "height": 36 }, "style": { "color": "#8A8178", "fontSize": 13 } },
      { "type": "spacer", "layout": { "width": "fill", "height": 12 } },
      {
        "type": "list",
        "id": "catalog",
        "data": "$sheet",
        "layout": { "width": "fill", "height": "wrap", "grow": 1 },
        "item": {
          "type": "column",
          "layout": { "width": "fill", "height": "wrap" },
          "children": [
            {
              "type": "column",
              "layout": { "width": "fill", "height": "wrap", "padding": 14 },
              "style": { "background": "#FFFCF8", "radius": 16 },
              "children": [
                { "type": "text", "text": "from / to", "layout": { "width": "fill", "height": 20 }, "style": { "color": "#C45C26", "fontSize": 13 } },
                { "type": "spacer", "layout": { "width": "fill", "height": 4 } },
                { "type": "text", "text": "可以写 0 到 1 的数字，也可以写 $ 表达式。下面两条分别是字面量 0.1→0.55，和数据里的 $start→$end。", "layout": { "width": "fill", "height": 52 }, "style": { "color": "#8A8178", "fontSize": 12 } },
                { "type": "progress", "layout": { "width": "fill", "height": 8 }, "from": 0.1, "to": 0.55, "animate": false, "style": { "track": "#E7E1D8", "bar": "#1F6F6A" } },
                { "type": "spacer", "layout": { "width": "fill", "height": 12 } },
                { "type": "progress", "layout": { "width": "fill", "height": 8 }, "from": "$start", "to": "$end", "animate": false, "style": { "track": "$track", "bar": "$bar" } }
              ]
            },
            { "type": "spacer", "layout": { "width": "fill", "height": 12 } },
            {
              "type": "column",
              "layout": { "width": "fill", "height": "wrap", "padding": 14 },
              "style": { "background": "#FFFCF8", "radius": 16 },
              "children": [
                { "type": "text", "text": "animate", "layout": { "width": "fill", "height": 20 }, "style": { "color": "#C45C26", "fontSize": 13 } },
                { "type": "spacer", "layout": { "width": "fill", "height": 4 } },
                { "type": "text", "text": "true 时从 0 过渡到目标长度，false 直接画好。", "layout": { "width": "fill", "height": 36 }, "style": { "color": "#8A8178", "fontSize": 12 } },
                { "type": "progress", "layout": { "width": "fill", "height": 10 }, "from": 0, "to": 0.72, "animate": true, "style": { "track": "#E7E1D8", "bar": "#C45C26", "radius": 5 } }
              ]
            },
            { "type": "spacer", "layout": { "width": "fill", "height": 12 } },
            {
              "type": "column",
              "layout": { "width": "fill", "height": "wrap", "padding": 14 },
              "style": { "background": "#FFFCF8", "radius": 16 },
              "children": [
                { "type": "text", "text": "track / bar / layout", "layout": { "width": "fill", "height": 20 }, "style": { "color": "#C45C26", "fontSize": 13 } },
                { "type": "spacer", "layout": { "width": "fill", "height": 4 } },
                { "type": "text", "text": "track 是底槽颜色，bar 是进度颜色，也可以写成渐变。width、height 决定槽的大小，radius 裁圆角。", "layout": { "width": "fill", "height": 36 }, "style": { "color": "#8A8178", "fontSize": 12 } },
                { "type": "progress", "layout": { "width": 180, "height": 14 }, "from": 0.2, "to": 0.9, "animate": false, "style": { "track": "#F3E2D4", "bar": "#1F1A17", "radius": 7, "border": { "color": "#C45C26", "width": 1 } } },
                { "type": "spacer", "layout": { "width": "fill", "height": 12 } },
                { "type": "progress", "layout": { "width": "fill", "height": 10 }, "from": 0.08, "to": 0.78, "animate": false, "style": { "track": "#E7E1D8", "bar": { "direction": "right", "colors": ["#7EB6C9", "#F2C14E", "#E07A3D"] }, "radius": 5 } }
              ]
            },
            { "type": "spacer", "layout": { "width": "fill", "height": 16 } }
          ]
        }
      }
    ]
  },
  "events": {
    "goBack": { "action": "back" }
  }
}
