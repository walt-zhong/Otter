{
  "layout": {
    "type": "column",
    "id": "page",
    "layout": {
      "width": "fill",
      "height": "fill",
      "padding": { "start": 20, "end": 20, "top": 12, "bottom": 8 }
    },
    "style": { "background": "#F3EFE7" },
    "children": [
      { "type": "spacer", "layout": { "width": "fill", "height": 4 } },
      { "type": "text", "text": "SWITCH", "layout": { "width": "fill", "height": 16 }, "style": { "color": "#C45C26", "fontSize": 12 } },
      { "type": "spacer", "layout": { "width": "fill", "height": 4 } },
      { "type": "text", "text": "开关", "layout": { "width": "fill", "height": 30 }, "style": { "color": "#1F1A17", "fontSize": 22 } },
      { "type": "spacer", "layout": { "width": "fill", "height": 4 } },
      { "type": "text", "text": "checked 决定开或关，label 是旁边的字。再点一次可以关上。", "layout": { "width": "fill", "height": 36 }, "style": { "color": "#8A8178", "fontSize": 13 } },
      { "type": "spacer", "layout": { "width": "fill", "height": 12 } },
      {
        "type": "list",
        "id": "catalog",
        "data": "$sheet",
        "layout": { "width": "fill", "height": "wrap", "grow": 1 },
        "item": {
          "type": "column",
          "layout": { "width": "fill", "height": "wrap" },
          "children": [
            {
              "type": "column",
              "layout": { "width": "fill", "height": "wrap", "padding": 14 },
              "style": { "background": "#FFFCF8", "radius": 16 },
              "children": [
                { "type": "text", "text": "checked", "layout": { "width": "fill", "height": 20 }, "style": { "color": "#C45C26", "fontSize": 13 } },
                { "type": "spacer", "layout": { "width": "fill", "height": 4 } },
                { "type": "text", "text": "true 是开，false 是关。不写 checked 时默认关。", "layout": { "width": "fill", "height": 36 }, "style": { "color": "#8A8178", "fontSize": 12 } },
                { "type": "spacer", "layout": { "width": "fill", "height": 8 } },
                { "type": "switch", "checked": true, "label": "已经打开", "layout": { "width": "fill", "height": 48, "padding": { "start": 12, "end": 12 } }, "style": { "background": "#F6F1EA", "radius": 10, "color": "#1F1A17", "fontSize": 15, "tint": "#1F6F6A" } },
                { "type": "spacer", "layout": { "width": "fill", "height": 6 } },
                { "type": "switch", "checked": false, "label": "已经关闭", "layout": { "width": "fill", "height": 48, "padding": { "start": 12, "end": 12 } }, "style": { "background": "#F6F1EA", "radius": 10, "color": "#1F1A17", "fontSize": 15, "tint": "#1F6F6A" } },
                { "type": "spacer", "layout": { "width": "fill", "height": 6 } },
                { "type": "switch", "label": "默认关闭", "layout": { "width": "fill", "height": 48, "padding": { "start": 12, "end": 12 } }, "style": { "background": "#F6F1EA", "radius": 10, "color": "#1F1A17", "fontSize": 15, "tint": "#1F6F6A" } }
              ]
            },
            { "type": "spacer", "layout": { "width": "fill", "height": 12 } },
            {
              "type": "column",
              "layout": { "width": "fill", "height": "wrap", "padding": 14 },
              "style": { "background": "#FFFCF8", "radius": 16 },
              "children": [
                { "type": "text", "text": "checked / label", "layout": { "width": "fill", "height": 20 }, "style": { "color": "#C45C26", "fontSize": 13 } },
                { "type": "spacer", "layout": { "width": "fill", "height": 4 } },
                { "type": "text", "text": "可以用 $ 从数据取值。", "layout": { "width": "fill", "height": 20 }, "style": { "color": "#8A8178", "fontSize": 12 } },
                { "type": "spacer", "layout": { "width": "fill", "height": 8 } },
                { "type": "switch", "checked": "$wifi", "label": "$wifiLabel", "layout": { "width": "fill", "height": 48, "padding": { "start": 12, "end": 12 } }, "style": { "background": "#F6F1EA", "radius": 10, "color": "#1F1A17", "fontSize": 15, "tint": "#1F6F6A" } },
                { "type": "spacer", "layout": { "width": "fill", "height": 6 } },
                { "type": "switch", "checked": "$muted", "label": "$mutedLabel", "layout": { "width": "fill", "height": 48, "padding": { "start": 12, "end": 12 } }, "style": { "background": "#F6F1EA", "radius": 10, "color": "#1F1A17", "fontSize": 15, "tint": "#1F6F6A" } }
              ]
            },
            { "type": "spacer", "layout": { "width": "fill", "height": 12 } },
            {
              "type": "column",
              "layout": { "width": "fill", "height": "wrap", "padding": 14 },
              "style": { "background": "#FFFCF8", "radius": 16 },
              "children": [
                { "type": "text", "text": "tint / color / fontSize", "layout": { "width": "fill", "height": 20 }, "style": { "color": "#C45C26", "fontSize": 13 } },
                { "type": "spacer", "layout": { "width": "fill", "height": 4 } },
                { "type": "text", "text": "tint 是打开时的滑块颜色，color 和 fontSize 管标签。", "layout": { "width": "fill", "height": 36 }, "style": { "color": "#8A8178", "fontSize": 12 } },
                { "type": "spacer", "layout": { "width": "fill", "height": 8 } },
                { "type": "switch", "checked": true, "label": "滑块是强调色", "layout": { "width": "fill", "height": 48, "padding": { "start": 12, "end": 12 } }, "style": { "background": "#F6F1EA", "radius": 10, "tint": "#C45C26", "color": "#1F1A17", "fontSize": 14 } },
                { "type": "spacer", "layout": { "width": "fill", "height": 6 } },
                { "type": "switch", "checked": true, "label": "标签是青绿大字", "layout": { "width": "fill", "height": 52, "padding": { "start": 12, "end": 12 } }, "style": { "background": "#F6F1EA", "radius": 10, "tint": "#1F6F6A", "color": "#1F6F6A", "fontSize": 18 } },
                { "type": "spacer", "layout": { "width": "fill", "height": 6 } },
                { "type": "switch", "checked": true, "label": "颜色来自数据", "layout": { "width": "fill", "height": 48, "padding": { "start": 12, "end": 12 } }, "style": { "background": "#F6F1EA", "radius": 10, "tint": "$thumbTint", "color": "$labelColor", "fontSize": 16 } }
              ]
            },
            { "type": "spacer", "layout": { "width": "fill", "height": 12 } },
            {
              "type": "column",
              "layout": { "width": "fill", "height": "wrap", "padding": 14 },
              "style": { "background": "#FFFCF8", "radius": 16 },
              "children": [
                { "type": "text", "text": "id / onClick", "layout": { "width": "fill", "height": 20 }, "style": { "color": "#C45C26", "fontSize": 13 } },
                { "type": "spacer", "layout": { "width": "fill", "height": 4 } },
                { "type": "text", "text": "点击后用 setChecked 改带 id 的开关。", "layout": { "width": "fill", "height": 20 }, "style": { "color": "#8A8178", "fontSize": 12 } },
                { "type": "spacer", "layout": { "width": "fill", "height": 8 } },
                { "type": "switch", "id": "notice", "checked": false, "label": "等待打开", "layout": { "width": "fill", "height": 48, "padding": { "start": 12, "end": 12 } }, "style": { "background": "#F6F1EA", "radius": 10, "tint": "#C45C26", "color": "#1F1A17", "fontSize": 15 } },
                { "type": "spacer", "layout": { "width": "fill", "height": 8 } },
                { "type": "text", "text": "打开", "layout": { "width": "fill", "height": 48 }, "style": { "background": "#1F6F6A", "radius": 12, "color": "#F4FBF8", "fontSize": 15, "align": "center" }, "onClick": ["turnOn"] },
                { "type": "spacer", "layout": { "width": "fill", "height": 8 } },
                { "type": "text", "text": "关闭", "layout": { "width": "fill", "height": 48 }, "style": { "background": "#1F1A17", "radius": 12, "color": "#F3EFE7", "fontSize": 15, "align": "center" }, "onClick": ["turnOff"] }
              ]
            },
            { "type": "spacer", "layout": { "width": "fill", "height": 16 } }
          ]
        }
      }
    ]
  },
  "events": {
    "turnOn": { "action": "setChecked", "target": "notice", "value": true },
    "turnOff": { "action": "setChecked", "target": "notice", "value": false },
    "goBack": { "action": "back" }
  }
}
