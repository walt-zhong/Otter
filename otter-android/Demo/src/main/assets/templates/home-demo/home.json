{
  "layout": {
    "type": "column",
    "id": "home",
    "layout": {
      "width": "fill",
      "height": "fill",
      "padding": { "start": 20, "end": 20, "top": 16, "bottom": 12 }
    },
    "style": { "background": "#F3EFE7" },
    "children": [
      {
        "type": "text",
        "id": "eyebrow",
        "text": "组件",
        "layout": { "width": "fill", "height": 16 },
        "style": { "color": "#C45C26", "fontSize": 11 }
      },
      {
        "type": "spacer",
        "layout": { "width": "fill", "height": 6 }
      },
      {
        "type": "text",
        "id": "title",
        "text": "Otter",
        "layout": { "width": "fill", "height": 34 },
        "style": { "color": "#1F1A17", "fontSize": 28 }
      },
      {
        "type": "spacer",
        "layout": { "width": "fill", "height": 4 }
      },
      {
        "type": "text",
        "id": "subtitle",
        "text": "全屏模版。往下是场景，再往下是组件。",
        "layout": { "width": "fill", "height": 22 },
        "style": { "color": "#8A8178", "fontSize": 14 }
      },
      {
        "type": "spacer",
        "layout": { "width": "fill", "height": 16 }
      },
      {
        "type": "list",
        "id": "demo_list",
        "data": "$demos",
        "direction": "vertical",
        "gap": 12,
        "layout": { "width": "fill", "height": "wrap", "grow": 1 },
        "item": {
          "type": "column",
          "layout": {
            "width": "fill",
            "height": "wrap",
            "padding": { "start": 16, "end": 16, "top": 14, "bottom": 14 }
          },
          "style": { "background": "#FFFCF8", "radius": 18 },
          "onClick": ["openPage"],
          "children": [
            {
              "type": "row",
              "layout": {
                "width": "fill",
                "height": "wrap",
                "align": "center",
                "justify": "spaceBetween"
              },
              "children": [
                {
                  "type": "row",
                  "layout": { "width": "wrap", "height": "wrap", "align": "center" },
                  "children": [
                    {
                      "type": "text",
                      "text": "$index",
                      "layout": { "width": 28, "height": 22 },
                      "style": { "color": "#C45C26", "fontSize": 13 }
                    },
                    {
                      "type": "text",
                      "text": "$title",
                      "layout": { "width": 180, "height": 24 },
                      "style": { "color": "#1F1A17", "fontSize": 17 }
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": "$tag",
                  "layout": { "width": 40, "height": 20 },
                  "style": { "color": "#1F6F6A", "fontSize": 12, "align": "end" }
                }
              ]
            },
            {
              "type": "spacer",
              "layout": { "width": "fill", "height": 6 }
            },
            {
              "type": "text",
              "text": "$desc",
              "layout": { "width": "fill", "height": "wrap" },
              "style": { "color": "#8A8178", "fontSize": 13 }
            },
            {
              "type": "spacer",
              "layout": { "width": "fill", "height": 8 }
            },
            {
              "type": "text",
              "text": "打开示例",
              "layout": { "width": 72, "height": 18 },
              "style": { "color": "#1F6F6A", "fontSize": 12 }
            }
          ]
        }
      }
    ]
  },
  "events": {
    "openPage": {
      "action": "open",
      "page": "$page"
    }
  }
}
