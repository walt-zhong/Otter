{
  "layout": {
    "type": "column",
    "id": "page",
    "layout": {
      "width": "fill",
      "height": "wrap",
      "padding": { "start": 20, "end": 20, "top": 20, "bottom": 20 }
    },
    "children": [
      {
        "type": "text",
        "id": "kicker",
        "text": "列表",
        "layout": { "width": "fill", "height": 16 },
        "style": { "color": "#C45C26", "fontSize": 12 }
      },
      {
        "type": "spacer",
        "layout": { "width": "fill", "height": 6 }
      },
      {
        "type": "text",
        "id": "heading",
        "text": "今天的四条",
        "layout": { "width": "fill", "height": 30 },
        "style": { "color": "#1F1A17", "fontSize": 22 }
      },
      {
        "type": "spacer",
        "layout": { "width": "fill", "height": 16 }
      },
      {
        "type": "list",
        "id": "feed",
        "data": "$data",
        "direction": "vertical",
        "gap": 12,
        "layout": { "width": "fill", "height": 392 },
        "item": {
          "type": "row",
          "layout": {
            "width": "fill",
            "height": 88,
            "padding": 10,
            "align": "center"
          },
          "style": { "background": "#FFFCF8", "radius": 18 },
          "onClick": ["showToast"],
          "children": [
            {
              "type": "image",
              "src": "$img",
              "layout": { "width": 68, "height": 68 },
              "style": { "radius": 14 }
            },
            {
              "type": "spacer",
              "layout": { "width": 12, "height": 68 }
            },
            {
              "type": "column",
              "layout": {
                "width": "wrap",
                "height": "wrap",
                "justify": "center"
              },
              "children": [
                {
                  "type": "text",
                  "text": "$title",
                  "layout": { "width": 180, "height": 24 },
                  "style": { "color": "#1F1A17", "fontSize": 16 }
                },
                {
                  "type": "spacer",
                  "layout": { "width": 180, "height": 4 }
                },
                {
                  "type": "text",
                  "text": "$subtitle",
                  "layout": { "width": 180, "height": 20 },
                  "style": { "color": "#8A8178", "fontSize": 13 }
                }
              ]
            }
          ]
        }
      }
    ]
  },
  "events": {
    "showToast": {
      "action": "toast",
      "message": "$title"
    }
  }
}
