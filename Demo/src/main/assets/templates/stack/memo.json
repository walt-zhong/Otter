{
  "layout": {
    "type": "column",
    "id": "memo",
    "layout": {
      "width": "fill",
      "height": "fill",
      "padding": { "start": 20, "end": 20, "top": 8, "bottom": 12 }
    },
    "style": { "background": "#F3EFE7" },
    "children": [
      {
        "type": "row",
        "id": "back",
        "layout": { "width": "fill", "height": 36, "align": "center" },
        "onClick": ["goBack"],
        "children": [
          { "type": "image", "src": "res:ic_back", "layout": { "width": 18, "height": 18 } },
          { "type": "spacer", "layout": { "width": 6, "height": 18 } },
          {
            "type": "text",
            "text": "地点",
            "layout": { "width": 40, "height": 20 },
            "style": { "color": "#1F1A17", "fontSize": 14 }
          }
        ]
      },
      { "type": "spacer", "layout": { "width": "fill", "height": 12 } },
      {
        "type": "text",
        "text": "备忘",
        "layout": { "width": "fill", "height": 16 },
        "style": { "color": "$ink", "fontSize": 12 }
      },
      { "type": "spacer", "layout": { "width": "fill", "height": 6 } },
      {
        "type": "text",
        "id": "title",
        "text": "$title",
        "layout": { "width": "fill", "height": 34 },
        "style": { "color": "#1F1A17", "fontSize": 26 }
      },
      { "type": "spacer", "layout": { "width": "fill", "height": 6 } },
      {
        "type": "text",
        "text": "先点记下。返回后，这些句子会出现在上一页。",
        "layout": { "width": "fill", "height": 40 },
        "style": { "color": "#8A8178", "fontSize": 13 }
      },
      { "type": "spacer", "layout": { "width": "fill", "height": 14 } },
      {
        "type": "row",
        "layout": { "width": "fill", "height": 48, "align": "center" },
        "children": [
          {
            "type": "input",
            "id": "draft",
            "hint": "记一句，比如带现金",
            "layout": {
              "width": "fill",
              "height": 48,
              "padding": { "start": 14, "end": 14 },
              "grow": 1
            },
            "style": {
              "background": "#FFFCF8",
              "radius": 16,
              "color": "#1F1A17",
              "fontSize": 15,
              "hintColor": "#8A8178"
            }
          },
          { "type": "spacer", "layout": { "width": 8, "height": 48 } },
          {
            "type": "text",
            "text": "记下",
            "layout": { "width": 64, "height": 48 },
            "style": {
              "background": "#1F1A17",
              "radius": 16,
              "color": "#F6E7C1",
              "fontSize": 14,
              "align": "center"
            },
            "onClick": ["addLine"]
          }
        ]
      },
      { "type": "spacer", "layout": { "width": "fill", "height": 14 } },
      {
        "type": "list",
        "id": "lines",
        "data": "$lines",
        "direction": "vertical",
        "gap": 8,
        "layout": { "width": "fill", "height": "wrap", "grow": 1 },
        "item": {
          "type": "row",
          "layout": {
            "width": "fill",
            "height": 52,
            "padding": { "start": 14, "end": 14 },
            "align": "center"
          },
          "style": { "background": "#FFFCF8", "radius": 16 },
          "children": [
            {
              "type": "spacer",
              "layout": { "width": 8, "height": 8 },
              "style": { "background": "#C45C26", "radius": 4 }
            },
            { "type": "spacer", "layout": { "width": 12, "height": 8 } },
            {
              "type": "text",
              "text": "$text",
              "layout": { "width": "fill", "height": 22, "grow": 1 },
              "style": { "color": "#1F1A17", "fontSize": 15 }
            }
          ]
        }
      }
    ]
  },
  "events": {
    "goBack": {
      "action": "back",
      "params": { "memos": "$lines" }
    },
    "addLine": {
      "action": "append",
      "list": "lines",
      "from": "draft",
      "field": "text",
      "data": "lines",
      "empty": "先写一句",
      "item": {}
    }
  }
}
