{
  "layout": {
    "type": "column",
    "id": "cl_container",
    "layout": {
      "width": "fill",
      "height": "wrap",
      "justify": "center",
      "align": "center"
    },
    "style": {
      "background": "#ffff00",
      "border": { "color": "#ff0000", "width": 10 },
      "radius": { "topStart": 30, "topEnd": 20, "bottomEnd": 20, "bottomStart": 10 }
    },
    "children": [
      {
        "type": "text",
        "id": "text_tip",
        "text": "100+100",
        "layout": { "width": 200, "height": 100 },
        "style": {
          "background": "#0000ff",
          "radius": 20,
          "color": "#00ff00",
          "fontSize": 30
        },
        "onClick": ["changeAttr", "showToast", "updateStyle"]
      },
      {
        "type": "text",
        "id": "text_tip",
        "text": "$text1_column",
        "layout": { "width": "wrap", "height": 100 },
        "style": { "color": "#ff0000", "fontSize": 20 },
        "onClick": ["changeAttr"]
      },
      {
        "type": "image",
        "id": "img_content",
        "src": "$img",
        "layout": { "width": 200, "height": 200 },
        "style": {
          "border": { "color": "#ff0000", "width": 5 },
          "radius": { "topStart": 20, "topEnd": 10, "bottomEnd": 15, "bottomStart": 30 }
        }
      },
      {
        "type": "row",
        "id": "rw_container",
        "layout": {
          "width": "fill",
          "height": "wrap",
          "justify": "center",
          "align": "center"
        },
        "style": {
          "background": {
            "direction": "bottom",
            "colors": ["#8b572a", "#f5a623"]
          },
          "radius": { "topStart": 20, "topEnd": 20, "bottomEnd": 10, "bottomStart": 30 }
        },
        "children": [
          {
            "type": "text",
            "id": "text1",
            "text": "$text2_row",
            "layout": { "width": 100, "height": 100 },
            "style": {
              "background": "#00ff00",
              "border": { "color": "#0000ff", "width": 10 },
              "radius": { "topStart": 20, "topEnd": 20, "bottomEnd": 40, "bottomStart": 30 },
              "color": "#ffffff",
              "fontSize": 7
            },
            "onClick": ["changeAttr"]
          },
          {
            "type": "image",
            "id": "img1",
            "src": "$imgUrl",
            "layout": { "width": 200, "height": 200 },
            "style": { "radius": { "topStart": 30 } }
          }
        ]
      }
    ]
  },
  "events": {
    "changeAttr": {
      "action": "setText",
      "target": "text1",
      "value": "$textTip"
    },
    "showToast": {
      "action": "toast",
      "message": "$toastMsg"
    },
    "updateStyle": {
      "action": "setTextStyle",
      "target": "text_tip",
      "fontSize": 14,
      "color": "#CCCCCC",
      "text": "我改变了！！！！！"
    }
  }
}
