{
  "layout": {
    "type": "column",
    "id": "page",
    "layout": {
      "width": "fill",
      "height": "wrap",
      "padding": { "start": 20, "end": 20, "top": 20, "bottom": 20 }
    },
    "children": [
      {
        "type": "text",
        "id": "kicker",
        "text": "布局",
        "layout": { "width": "fill", "height": 16 },
        "style": { "color": "#C45C26", "fontSize": 12 }
      },
      {
        "type": "spacer",
        "layout": { "width": "fill", "height": 6 }
      },
      {
        "type": "text",
        "id": "heading",
        "text": "一张卡片里的层级",
        "layout": { "width": "fill", "height": 30 },
        "style": { "color": "#1F1A17", "fontSize": 22 }
      },
      {
        "type": "spacer",
        "layout": { "width": "fill", "height": 16 }
      },
      {
        "type": "column",
        "id": "card",
        "layout": {
          "width": "fill",
          "height": "wrap",
          "padding": 16,
          "align": "center"
        },
        "style": { "background": "#FFFCF8", "radius": 24 },
        "children": [
          {
            "type": "text",
            "id": "text_tip",
            "text": "100+100",
            "layout": { "width": "fill", "height": 52 },
            "style": {
              "background": "#1F6F6A",
              "radius": 16,
              "color": "#F4FBF8",
              "fontSize": 18,
              "align": "center"
            },
            "onClick": ["changeAttr", "showToast", "updateStyle"]
          },
          {
            "type": "spacer",
            "layout": { "width": "fill", "height": 12 }
          },
          {
            "type": "text",
            "id": "text_column",
            "text": "$text1_column",
            "layout": { "width": "fill", "height": 24 },
            "style": { "color": "#1F1A17", "fontSize": 15, "align": "center" },
            "onClick": ["changeAttr"]
          },
          {
            "type": "spacer",
            "layout": { "width": "fill", "height": 12 }
          },
          {
            "type": "image",
            "id": "img_content",
            "src": "$img",
            "layout": { "width": "fill", "height": 168 },
            "style": { "radius": 18 }
          },
          {
            "type": "spacer",
            "layout": { "width": "fill", "height": 12 }
          },
          {
            "type": "row",
            "id": "rw_container",
            "layout": {
              "width": "fill",
              "height": "wrap",
              "justify": "spaceBetween",
              "align": "center"
            },
            "children": [
              {
                "type": "text",
                "id": "text1",
                "text": "$text2_row",
                "layout": { "width": 136, "height": 96, "padding": 12 },
                "style": {
                  "background": "#F3E2D4",
                  "radius": 16,
                  "color": "#1F1A17",
                  "fontSize": 14
                },
                "onClick": ["changeAttr"]
              },
              {
                "type": "image",
                "id": "img1",
                "src": "$imgUrl",
                "layout": { "width": 136, "height": 96 },
                "style": { "radius": 16 }
              }
            ]
          }
        ]
      }
    ]
  },
  "events": {
    "changeAttr": {
      "action": "setText",
      "target": "text1",
      "value": "$textTip"
    },
    "showToast": {
      "action": "toast",
      "message": "$toastMsg"
    },
    "updateStyle": {
      "action": "setTextStyle",
      "target": "text_tip",
      "fontSize": 16,
      "color": "#F6E7C1",
      "text": "样式已经换过"
    }
  }
}
