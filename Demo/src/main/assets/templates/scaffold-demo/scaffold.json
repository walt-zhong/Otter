{
  "layout": {
    "type": "column",
    "id": "page",
    "layout": {
      "width": "fill",
      "height": "wrap",
      "padding": { "start": 20, "end": 20, "top": 20, "bottom": 20 }
    },
    "children": [
      {
        "type": "text",
        "id": "kicker",
        "text": "骨架",
        "layout": { "width": "fill", "height": 16 },
        "style": { "color": "#C45C26", "fontSize": 12 }
      },
      {
        "type": "spacer",
        "layout": { "width": "fill", "height": 6 }
      },
      {
        "type": "text",
        "id": "heading",
        "text": "一页该有的结构",
        "layout": { "width": "fill", "height": 30 },
        "style": { "color": "#1F1A17", "fontSize": 22 }
      },
      {
        "type": "spacer",
        "layout": { "width": "fill", "height": 16 }
      },
      {
        "type": "column",
        "id": "card",
        "layout": {
          "width": "fill",
          "height": "wrap",
          "padding": 20
        },
        "style": { "background": "#FFFCF8", "radius": 24 },
        "children": [
          {
            "type": "text",
            "id": "body",
            "text": "$textTip",
            "layout": { "width": "fill", "height": 96 },
            "style": { "color": "#1F1A17", "fontSize": 16 }
          },
          {
            "type": "spacer",
            "layout": { "width": "fill", "height": 16 }
          },
          {
            "type": "text",
            "id": "action",
            "text": "知道了",
            "layout": { "width": "fill", "height": 48 },
            "style": {
              "background": "#1F1A17",
              "radius": 16,
              "color": "#F3EFE7",
              "fontSize": 15,
              "align": "center"
            },
            "onClick": ["showToast"]
          }
        ]
      }
    ]
  },
  "events": {
    "showToast": {
      "action": "toast",
      "message": "$toastMsg"
    }
  }
}
