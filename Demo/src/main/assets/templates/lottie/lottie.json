{
  "layout": {
    "type": "column",
    "id": "page",
    "layout": {
      "width": "fill",
      "height": "fill",
      "padding": { "start": 20, "end": 20, "top": 12, "bottom": 8 }
    },
    "style": { "background": "#F3EFE7" },
    "children": [
      {
        "type": "row",
        "id": "back",
        "layout": { "width": "fill", "height": 36, "align": "center" },
        "onClick": ["goBack"],
        "children": [
          { "type": "image", "src": "res:ic_back", "layout": { "width": 18, "height": 18 } },
          { "type": "spacer", "layout": { "width": 4, "height": 18 } },
          { "type": "text", "text": "返回", "layout": { "width": 40, "height": 20 }, "style": { "color": "#1F1A17", "fontSize": 14 } }
        ]
      },
      { "type": "spacer", "layout": { "width": "fill", "height": 4 } },
      { "type": "text", "text": "LOTTIE", "layout": { "width": "fill", "height": 16 }, "style": { "color": "#C45C26", "fontSize": 12 } },
      { "type": "spacer", "layout": { "width": "fill", "height": 4 } },
      { "type": "text", "text": "动画", "layout": { "width": "fill", "height": 30 }, "style": { "color": "#1F1A17", "fontSize": 22 } },
      { "type": "spacer", "layout": { "width": "fill", "height": 4 } },
      { "type": "text", "text": "必填 src。其余属性都有默认值。", "layout": { "width": "fill", "height": 20 }, "style": { "color": "#8A8178", "fontSize": 13 } },
      { "type": "spacer", "layout": { "width": "fill", "height": 12 } },
      {
        "type": "list",
        "id": "catalog",
        "data": "$sheet",
        "layout": { "width": "fill", "height": "wrap", "grow": 1 },
        "item": {
          "type": "column",
          "layout": { "width": "fill", "height": "wrap" },
          "children": [
            {
              "type": "column",
              "layout": { "width": "fill", "height": "wrap", "padding": 14, "align": "center" },
              "style": { "background": "#FFFCF8", "radius": 16 },
              "children": [
                { "type": "text", "text": "src / repeat / mode / autoPlay", "layout": { "width": "fill", "height": 20 }, "style": { "color": "#C45C26", "fontSize": 13 } },
                { "type": "spacer", "layout": { "width": "fill", "height": 4 } },
                { "type": "text", "text": "src 用 assets: 读本地，或用 https 读远端。repeat 是 infinite 或次数。mode 是 restart、reverse。autoPlay 默认 true。", "layout": { "width": "fill", "height": 52 }, "style": { "color": "#8A8178", "fontSize": 12 } },
                { "type": "lottie", "id": "loop", "src": "assets:animation/lottie-sunny", "repeat": "infinite", "mode": "restart", "autoPlay": true, "layout": { "width": 72, "height": 72 } },
                { "type": "text", "text": "infinite + restart + autoPlay", "layout": { "width": "fill", "height": 18 }, "style": { "color": "#8A8178", "fontSize": 12, "align": "center" } }
              ]
            },
            { "type": "spacer", "layout": { "width": "fill", "height": 12 } },
            {
              "type": "column",
              "layout": { "width": "fill", "height": "wrap", "padding": 14, "align": "center" },
              "style": { "background": "#FFFCF8", "radius": 16 },
              "children": [
                { "type": "text", "text": "repeat 2，mode reverse", "layout": { "width": "fill", "height": 20 }, "style": { "color": "#1F1A17", "fontSize": 14, "align": "center" } },
                { "type": "spacer", "layout": { "width": "fill", "height": 8 } },
                { "type": "lottie", "id": "reverse_once", "src": "assets:animation/lottie-sunny", "repeat": 2, "mode": "reverse", "autoPlay": true, "layout": { "width": 72, "height": 72 }, "style": { "background": "#F6F1EA", "radius": 16 } }
              ]
            },
            { "type": "spacer", "layout": { "width": "fill", "height": 12 } },
            {
              "type": "column",
              "layout": { "width": "fill", "height": "wrap", "padding": 14, "align": "center" },
              "style": { "background": "#FFFCF8", "radius": 16 },
              "children": [
                { "type": "text", "text": "layout / background / radius / border", "layout": { "width": "fill", "height": 20 }, "style": { "color": "#C45C26", "fontSize": 13 } },
                { "type": "spacer", "layout": { "width": "fill", "height": 4 } },
                { "type": "text", "text": "盒子大小、底色、圆角和描边与其他组件相同。autoPlay 为 false 时停在第一帧。", "layout": { "width": "fill", "height": 36 }, "style": { "color": "#8A8178", "fontSize": 12 } },
                { "type": "lottie", "id": "paused", "src": "$remote", "repeat": "infinite", "mode": "restart", "autoPlay": false, "layout": { "width": 88, "height": 88 }, "style": { "background": "#243044", "radius": 20, "border": { "color": "#F6E7C1", "width": 1 } } },
                { "type": "spacer", "layout": { "width": "fill", "height": 6 } },
                { "type": "text", "text": "https 资源，autoPlay false", "layout": { "width": "fill", "height": 18 }, "style": { "color": "#8A8178", "fontSize": 12, "align": "center" } }
              ]
            },
            { "type": "spacer", "layout": { "width": "fill", "height": 16 } }
          ]
        }
      }
    ]
  },
  "events": {
    "goBack": { "action": "back" }
  }
}
