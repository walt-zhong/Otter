{
  "layout": {
    "type": "column",
    "id": "cl_container",
    "layout": {
      "width": "fill",
      "height": "wrap",
      "padding": { "start": 20, "end": 20, "bottom": 20 },
      "justify": "center",
      "align": "center"
    },
    "style": {
      "background": "#ffff00",
      "border": { "color": "#ff0000", "width": 10 },
      "radius": { "topStart": 30, "topEnd": 20, "bottomEnd": 20, "bottomStart": 10 }
    },
    "children": [
      {
        "type": "lottie",
        "id": "ani_loading",
        "src": "https://files.alicdn.com/tpsservice/d32faa78264b12792655ba7ef47235d3.zip",
        "repeat": "infinite",
        "mode": "restart",
        "autoPlay": true,
        "layout": { "width": 100, "height": 100 },
        "style": { "background": "#0000ff", "radius": 15 }
      },
      {
        "type": "spacer",
        "layout": { "width": "fill", "height": 10 }
      },
      {
        "type": "lottie",
        "id": "ani_loading1",
        "src": "assets:animation/lottie-sunny",
        "repeat": "infinite",
        "mode": "restart",
        "autoPlay": true,
        "layout": { "width": 50, "height": 50 },
        "style": { "background": "transparent", "radius": 15 }
      }
    ]
  }
}
