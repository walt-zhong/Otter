{
  "layout": {
    "type": "column",
    "id": "page",
    "layout": {
      "width": "fill",
      "height": "wrap",
      "padding": { "start": 20, "end": 20, "top": 20, "bottom": 20 },
      "align": "center"
    },
    "children": [
      {
        "type": "text",
        "id": "kicker",
        "text": "动画",
        "layout": { "width": "fill", "height": 16 },
        "style": { "color": "#C45C26", "fontSize": 12 }
      },
      {
        "type": "spacer",
        "layout": { "width": "fill", "height": 6 }
      },
      {
        "type": "text",
        "id": "heading",
        "text": "循环着的两段",
        "layout": { "width": "fill", "height": 30 },
        "style": { "color": "#1F1A17", "fontSize": 22 }
      },
      {
        "type": "spacer",
        "layout": { "width": "fill", "height": 16 }
      },
      {
        "type": "column",
        "id": "remote_card",
        "layout": {
          "width": "fill",
          "height": "wrap",
          "padding": 16,
          "align": "center"
        },
        "style": {
          "background": {
            "direction": "bottom",
            "colors": ["#243044", "#3E5568"]
          },
          "radius": 24
        },
        "children": [
          {
            "type": "lottie",
            "id": "ani_loading",
            "src": "https://files.alicdn.com/tpsservice/d32faa78264b12792655ba7ef47235d3.zip",
            "repeat": "infinite",
            "mode": "restart",
            "autoPlay": true,
            "layout": { "width": 120, "height": 120 }
          },
          {
            "type": "spacer",
            "layout": { "width": "fill", "height": 8 }
          },
          {
            "type": "text",
            "id": "remote_label",
            "text": "远端资源",
            "layout": { "width": 120, "height": 20 },
            "style": { "color": "#E7EEF2", "fontSize": 13, "align": "center" }
          }
        ]
      },
      {
        "type": "spacer",
        "layout": { "width": "fill", "height": 12 }
      },
      {
        "type": "column",
        "id": "local_card",
        "layout": {
          "width": "fill",
          "height": "wrap",
          "padding": 16,
          "align": "center"
        },
        "style": { "background": "#FFFCF8", "radius": 24 },
        "children": [
          {
            "type": "lottie",
            "id": "ani_loading1",
            "src": "assets:animation/lottie-sunny",
            "repeat": "infinite",
            "mode": "restart",
            "autoPlay": true,
            "layout": { "width": 72, "height": 72 }
          },
          {
            "type": "spacer",
            "layout": { "width": "fill", "height": 8 }
          },
          {
            "type": "text",
            "id": "local_label",
            "text": "本地晴天",
            "layout": { "width": 120, "height": 20 },
            "style": { "color": "#1F1A17", "fontSize": 13, "align": "center" }
          }
        ]
      }
    ]
  }
}
