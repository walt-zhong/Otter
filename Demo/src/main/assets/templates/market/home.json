{
  "layout": {
    "type": "column",
    "id": "home",
    "layout": {
      "width": "fill",
      "height": "fill",
      "padding": { "start": 20, "end": 20, "top": 8, "bottom": 12 }
    },
    "style": { "background": "#F6F1EA" },
    "children": [
      {
        "type": "row",
        "layout": {
          "width": "fill",
          "height": "wrap",
          "align": "center",
          "justify": "spaceBetween"
        },
        "children": [
          {
            "type": "column",
            "layout": { "width": "fill", "height": "wrap", "grow": 1 },
            "children": [
              {
                "type": "text",
                "id": "title",
                "text": "南市",
                "layout": { "width": "fill", "height": "wrap" },
                "style": { "color": "#1F1A17", "fontSize": 28, "fontWeight": "bold" }
              },
              {
                "type": "spacer",
                "layout": { "width": "fill", "height": 4 }
              },
              {
                "type": "text",
                "text": "巷口四家店，今天都在。",
                "layout": { "width": "fill", "height": "wrap" },
                "style": { "color": "#8A8178", "fontSize": 14 }
              }
            ]
          },
          {
            "type": "spacer",
            "layout": { "width": 12, "height": 8 }
          },
          {
            "type": "text",
            "text": "购物车",
            "layout": {
              "width": "wrap",
              "height": "wrap",
              "padding": { "start": 14, "end": 14, "top": 8, "bottom": 8 }
            },
            "style": {
              "background": "#8B572A",
              "radius": 12,
              "color": "#F6F1EA",
              "fontSize": 14,
              "align": "center",
              "fontWeight": "medium"
            },
            "onClick": ["openCart"]
          }
        ]
      },
      {
        "type": "spacer",
        "layout": { "width": "fill", "height": 16 }
      },
      {
        "type": "input",
        "id": "query",
        "value": "$query",
        "hint": "搜店铺",
        "layout": {
          "width": "fill",
          "height": 44,
          "padding": { "start": 14, "end": 14 }
        },
        "style": {
          "background": "#FFFFFF",
          "radius": 12,
          "border": { "color": "#E6DDD2", "width": 1 },
          "color": "#1F1A17",
          "fontSize": 15,
          "hintColor": "#8A8178"
        },
        "onChange": ["filterShops"]
      },
      {
        "type": "spacer",
        "layout": { "width": "fill", "height": 12 }
      },
      {
        "type": "text",
        "id": "closedBanner",
        "text": "有店铺今日休息",
        "visible": "$hasClosed",
        "layout": {
          "width": "fill",
          "height": "wrap",
          "padding": { "start": 12, "end": 12, "top": 10, "bottom": 10 }
        },
        "style": {
          "background": "#FFFFFF",
          "radius": 12,
          "color": "#8B572A",
          "fontSize": 13,
          "fontWeight": "medium"
        }
      },
      {
        "type": "spacer",
        "layout": { "width": "fill", "height": 12 }
      },
      {
        "type": "text",
        "id": "noResult",
        "text": "没有找到这家店",
        "visible": "$noResult",
        "layout": { "width": "fill", "height": "wrap" },
        "style": { "color": "#8A8178", "fontSize": 14 }
      },
      {
        "type": "list",
        "id": "shops",
        "data": "$shops",
        "direction": "vertical",
        "gap": 12,
        "layout": { "width": "fill", "height": "wrap", "grow": 1 },
        "item": {
          "type": "column",
          "layout": {
            "width": "fill",
            "height": "wrap",
            "padding": { "start": 14, "end": 14, "top": 14, "bottom": 14 }
          },
          "style": {
            "background": "#FFFFFF",
            "radius": 16,
            "border": { "color": "#E6DDD2", "width": 1 }
          },
          "onClick": ["openShop"],
          "children": [
            {
              "type": "row",
              "layout": { "width": "fill", "height": "wrap", "align": "start" },
              "children": [
                {
                  "type": "image",
                  "src": "$image",
                  "layout": {
                    "width": 72,
                    "height": 72,
                    "aspectRatio": 1,
                    "alignSelf": "start"
                  },
                  "style": { "radius": 12, "fit": "cover" }
                },
                {
                  "type": "spacer",
                  "layout": { "width": 12, "height": 12 }
                },
                {
                  "type": "column",
                  "layout": { "width": "fill", "height": "wrap", "grow": 1 },
                  "children": [
                    {
                      "type": "text",
                      "text": "$name",
                      "layout": { "width": "fill", "height": "wrap" },
                      "style": { "color": "#1F1A17", "fontSize": 17, "fontWeight": "bold" }
                    },
                    {
                      "type": "spacer",
                      "layout": { "width": "fill", "height": 4 }
                    },
                    {
                      "type": "text",
                      "text": "$meta",
                      "layout": { "width": "fill", "height": "wrap" },
                      "style": { "color": "#8A8178", "fontSize": 12 }
                    },
                    {
                      "type": "spacer",
                      "layout": { "width": "fill", "height": 6 }
                    },
                    {
                      "type": "text",
                      "text": "$blurb",
                      "layout": { "width": "fill", "height": "wrap" },
                      "style": { "color": "#8A8178", "fontSize": 13 }
                    }
                  ]
                }
              ]
            },
            {
              "type": "spacer",
              "layout": { "width": "fill", "height": 10 }
            },
            {
              "type": "row",
              "layout": {
                "width": "fill",
                "height": "wrap",
                "wrap": true,
                "align": "center"
              },
              "children": [
                {
                  "type": "text",
                  "text": "$tagA",
                  "layout": {
                    "width": "wrap",
                    "height": "wrap",
                    "padding": { "start": 8, "end": 8, "top": 3, "bottom": 3 }
                  },
                  "style": {
                    "background": "#F6F1EA",
                    "radius": 8,
                    "color": "#8B572A",
                    "fontSize": 11
                  }
                },
                {
                  "type": "spacer",
                  "visible": "$showTagB",
                  "layout": { "width": 6, "height": 8 }
                },
                {
                  "type": "text",
                  "text": "$tagB",
                  "visible": "$showTagB",
                  "layout": {
                    "width": "wrap",
                    "height": "wrap",
                    "padding": { "start": 8, "end": 8, "top": 3, "bottom": 3 }
                  },
                  "style": {
                    "background": "#F6F1EA",
                    "radius": 8,
                    "color": "#8B572A",
                    "fontSize": 11
                  }
                }
              ]
            }
          ]
        }
      }
    ]
  },
  "events": {
    "openCart": { "action": "open", "page": "cart" },
    "filterShops": {
      "action": "host",
      "name": "filter",
      "params": { "query": "$query" }
    },
    "openShop": {
      "action": "open",
      "page": "shop",
      "params": {
        "id": "$id",
        "name": "$name",
        "blurb": "$blurb",
        "hours": "$hours",
        "phone": "$phone",
        "price": "$price",
        "image": "$image",
        "tagA": "$tagA",
        "tagB": "$tagB",
        "showTagB": "$showTagB",
        "member": "$member",
        "memberPrice": "$memberPrice",
        "closed": "$closed",
        "closedNote": "$closedNote",
        "note1": "$note1",
        "note2": "$note2",
        "note3": "$note3"
      }
    }
  }
}
