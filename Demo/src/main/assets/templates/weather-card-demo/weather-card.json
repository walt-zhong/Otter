{
  "layout": {
    "type": "column",
    "id": "page",
    "layout": {
      "width": "fill",
      "height": "fill",
      "padding": { "start": 16, "end": 16, "top": 12, "bottom": 16 }
    },
    "style": { "background": "#E4EEF1" },
    "children": [
      {
        "type": "row",
        "id": "back",
        "layout": { "width": "fill", "height": 36, "align": "center" },
        "onClick": ["goBack"],
        "children": [
          { "type": "image", "src": "res:ic_back", "layout": { "width": 18, "height": 18 } },
          { "type": "spacer", "layout": { "width": 4, "height": 18 } },
          { "type": "text", "text": "返回", "layout": { "width": 40, "height": 20 }, "style": { "color": "#1F1A17", "fontSize": 14 } }
        ]
      },
      { "type": "spacer", "layout": { "width": "fill", "height": 4 } },
      {
        "type": "text",
        "id": "page_kicker",
        "text": "海淀 · 今天",
        "layout": { "width": "fill", "height": 18 },
        "style": { "color": "#8A8178", "fontSize": 12 }
      },
      {
        "type": "spacer",
        "layout": { "width": "fill", "height": 10 }
      },
      {
        "type": "column",
        "id": "card",
        "layout": {
          "width": "fill",
          "height": "wrap",
          "grow": 1,
          "padding": 20
        },
        "style": {
          "background": {
            "direction": "bottom",
            "colors": ["#1B3A4B", "#3E6B73"]
          },
          "radius": 28
        },
        "children": [
          {
            "type": "row",
            "id": "loc_row",
            "layout": {
              "width": "fill",
              "height": "wrap",
              "justify": "spaceBetween",
              "align": "center"
            },
            "children": [
              {
                "type": "text",
                "id": "tv_cur_loc",
                "text": "$curLoc",
                "layout": { "width": 160, "height": 26 },
                "style": { "color": "#F4F7F8", "fontSize": 18 },
                "onClick": ["goMap", "resetStyle"]
              },
              {
                "type": "image",
                "id": "img_nav",
                "src": "res:ic_nav",
                "layout": { "width": 22, "height": 22 },
                "onClick": ["goMap"]
              }
            ]
          },
          {
            "type": "spacer",
            "layout": { "width": "fill", "height": 18 }
          },
          {
            "type": "text",
            "id": "tx_cur_tem",
            "text": "$curTem",
            "layout": { "width": 180, "height": 56 },
            "style": { "color": "#FFFFFF", "fontSize": 48 },
            "onClick": ["updateStyle", "showTemTip"]
          },
          {
            "type": "spacer",
            "layout": { "width": "fill", "height": 4 }
          },
          {
            "type": "row",
            "id": "desc_row",
            "layout": {
              "width": "fill",
              "height": "wrap",
              "align": "center"
            },
            "children": [
              {
                "type": "image",
                "id": "img_now",
                "src": "res:ic_cloudy",
                "layout": { "width": 22, "height": 22 }
              },
              {
                "type": "spacer",
                "layout": { "width": 8, "height": 22 }
              },
              {
                "type": "text",
                "id": "tv_cloud",
                "text": "$curWeatherDesc",
                "layout": { "width": 80, "height": 22 },
                "style": { "color": "#D5E4E8", "fontSize": 15 }
              }
            ]
          },
          {
            "type": "spacer",
            "layout": { "width": "fill", "height": 16 }
          },
          {
            "type": "row",
            "id": "range_row",
            "layout": {
              "width": "fill",
              "height": "wrap",
              "align": "center"
            },
            "children": [
              {
                "type": "text",
                "id": "label_max",
                "text": "最高",
                "layout": { "width": 32, "height": 20 },
                "style": { "color": "#D5E4E8", "fontSize": 12 }
              },
              {
                "type": "text",
                "id": "value_max",
                "text": "$maxTem",
                "layout": { "width": 48, "height": 24 },
                "style": { "color": "#FFFFFF", "fontSize": 16 }
              },
              {
                "type": "spacer",
                "layout": { "width": 16, "height": 24 }
              },
              {
                "type": "text",
                "id": "label_min",
                "text": "最低",
                "layout": { "width": 32, "height": 20 },
                "style": { "color": "#D5E4E8", "fontSize": 12 }
              },
              {
                "type": "text",
                "id": "value_min",
                "text": "$minTem",
                "layout": { "width": 48, "height": 24 },
                "style": { "color": "#FFFFFF", "fontSize": 16 }
              }
            ]
          },
          {
            "type": "spacer",
            "layout": { "width": "fill", "height": 16 }
          },
          {
            "type": "spacer",
            "layout": { "width": "fill", "height": 1 },
            "style": { "background": "#5E8A90" }
          },
          {
            "type": "spacer",
            "layout": { "width": "fill", "height": 12 }
          },
          {
            "type": "row",
            "id": "alert_row",
            "layout": {
              "width": "fill",
              "height": "wrap",
              "align": "center"
            },
            "children": [
              {
                "type": "image",
                "id": "img_alert",
                "src": "res:ic_warning",
                "layout": { "width": 18, "height": 18 }
              },
              {
                "type": "spacer",
                "layout": { "width": 8, "height": 18 }
              },
              {
                "type": "text",
                "id": "tv_high_tip",
                "text": "高温提醒  午后体感更热",
                "layout": { "width": 220, "height": 20 },
                "style": { "color": "#F6E7C1", "fontSize": 13 }
              }
            ]
          },
          {
            "type": "spacer",
            "layout": { "width": "fill", "height": 16 }
          },
          {
            "type": "text",
            "id": "hourly_title",
            "text": "小时预报",
            "layout": { "width": "fill", "height": 20 },
            "style": { "color": "#F4F7F8", "fontSize": 14 }
          },
          {
            "type": "spacer",
            "layout": { "width": "fill", "height": 10 }
          },
          {
            "type": "list",
            "id": "sd_list_horizontal",
            "data": "$weatherData24",
            "direction": "horizontal",
            "gap": 8,
            "layout": { "width": "fill", "height": 108 },
            "item": {
              "type": "column",
              "layout": {
                "width": 64,
                "height": "fill",
                "padding": { "top": 8, "bottom": 8 },
                "justify": "center",
                "align": "center"
              },
              "style": { "background": "#245566", "radius": 16 },
              "children": [
                {
                  "type": "text",
                  "text": "$time",
                  "layout": { "width": 56, "height": 18 },
                  "style": { "color": "#D5E4E8", "fontSize": 12, "align": "center" }
                },
                {
                  "type": "spacer",
                  "layout": { "width": "fill", "height": 8 }
                },
                {
                  "type": "image",
                  "src": "$img",
                  "layout": { "width": 28, "height": 28 }
                },
                {
                  "type": "spacer",
                  "layout": { "width": "fill", "height": 8 }
                },
                {
                  "type": "text",
                  "text": "$degree",
                  "layout": { "width": 56, "height": 20 },
                  "style": { "color": "#FFFFFF", "fontSize": 14, "align": "center" }
                }
              ]
            }
          },
          {
            "type": "spacer",
            "layout": { "width": "fill", "height": 16 }
          },
          {
            "type": "text",
            "id": "week_title",
            "text": "这周",
            "layout": { "width": "fill", "height": 20 },
            "style": { "color": "#F4F7F8", "fontSize": 14 }
          },
          {
            "type": "spacer",
            "layout": { "width": "fill", "height": 8 }
          },
          {
            "type": "list",
            "id": "sd_list_vertical",
            "data": "$weatherDataWeek",
            "direction": "vertical",
            "gap": 4,
            "layout": { "width": "fill", "height": "wrap", "grow": 1 },
            "item": {
              "type": "row",
              "layout": {
                "width": "fill",
                "height": 36,
                "align": "center",
                "justify": "spaceBetween"
              },
              "onClick": ["showToastMsg"],
              "children": [
                {
                  "type": "text",
                  "text": "$week",
                  "layout": { "width": 52, "height": 20 },
                  "style": { "color": "#F4F7F8", "fontSize": 13 }
                },
                {
                  "type": "lottie",
                  "src": "assets:animation/lottie-sunny",
                  "repeat": "infinite",
                  "mode": "restart",
                  "autoPlay": true,
                  "layout": { "width": 22, "height": 22 }
                },
                {
                  "type": "text",
                  "text": "$degreeMin",
                  "layout": { "width": 36, "height": 20 },
                  "style": { "color": "#D5E4E8", "fontSize": 13, "align": "end" }
                },
                {
                  "type": "progress",
                  "layout": { "width": 88, "height": 8 },
                  "from": "$curDegreeMinPercent",
                  "to": "$curDegreeMaxPercent",
                  "animate": false,
                  "style": {
                    "track": "#1E4550",
                    "bar": {
                      "direction": "right",
                      "colors": ["#7EB6C9", "#F2C14E", "#E07A3D"]
                    }
                  }
                },
                {
                  "type": "text",
                  "text": "$degreeMax",
                  "layout": { "width": 36, "height": 20 },
                  "style": { "color": "#FFFFFF", "fontSize": 13 }
                }
              ]
            }
          }
        ]
      }
    ]
  },
  "events": {
    "goBack": { "action": "back" },
    "goMap": {
      "action": "toast",
      "message": "打开地图导航"
    },
    "showTemTip": {
      "action": "toast",
      "message": " $temTip != null ? $temTip : '热死了'"
    },
    "showToastMsg": {
      "action": "toast",
      "message": "$week != null ? $week : '热到没度数'"
    },
    "updateStyle": {
      "action": "setTextStyle",
      "target": "tx_cur_tem",
      "fontSize": 40,
      "color": "#F6E7C1"
    },
    "resetStyle": {
      "action": "setTextStyle",
      "target": "tx_cur_tem",
      "fontSize": 48,
      "color": "#FFFFFF"
    }
  }
}
