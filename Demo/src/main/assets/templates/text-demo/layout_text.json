{
  "layout": {
    "type": "column",
    "layout": { "width": "fill", "height": "wrap" },
    "children": [
      {
        "type": "column",
        "id": "cl_container",
        "layout": {
          "width": "fill",
          "height": "wrap",
          "padding": { "start": 10, "end": 10, "top": 20, "bottom": 20 },
          "align": "center"
        },
        "style": {
          "background": "#ffffff",
          "border": { "color": "#ff0000", "width": 2 },
          "radius": { "topStart": 10, "topEnd": 10, "bottomEnd": 10, "bottomStart": 10 }
        },
        "children": [
          {
            "type": "text",
            "id": "text_tip",
            "text": "$textTip",
            "layout": { "width": 300, "height": 200, "padding": 20 },
            "style": {
              "background": "#00ffff",
              "radius": 20,
              "color": "#ffffff",
              "fontSize": 8,
              "align": "center"
            },
            "onClick": ["showToast", "updateStyle"]
          },
          {
            "type": "spacer",
            "layout": { "width": "fill", "height": 20 },
            "style": { "background": "transparent" }
          },
          {
            "type": "text",
            "id": "text_tip1",
            "text": "Hello",
            "layout": { "width": 300, "height": 200, "padding": 10 },
            "style": {
              "background": "#ff0000",
              "radius": 20,
              "color": "#ffffff",
              "fontSize": 10,
              "align": "start"
            },
            "onClick": ["showToast", "updateStyle"]
          },
          {
            "type": "spacer",
            "layout": { "width": "fill", "height": 20 }
          },
          {
            "type": "text",
            "id": "text_tip2",
            "text": "I Am Otter!!!",
            "layout": { "width": 300, "height": 200, "padding": 10 },
            "style": {
              "background": "#00ff00",
              "radius": 20,
              "color": "#ff0000",
              "fontSize": 5,
              "align": "end"
            },
            "onClick": ["showToast", "updateStyle"]
          },
          {
            "type": "spacer",
            "layout": { "width": "fill", "height": 20 }
          }
        ]
      },
      {
        "type": "row",
        "id": "row1",
        "layout": {
          "width": "fill",
          "height": 200,
          "padding": { "start": 10, "end": 10, "top": 10, "bottom": 10 },
          "justify": "center"
        },
        "style": {
          "background": "#00ff00",
          "border": { "color": "#ff0000", "width": 2 },
          "radius": 20
        },
        "children": [
          {
            "type": "text",
            "id": "text_tip2",
            "text": "Hello,Otter",
            "layout": { "width": 100, "height": "fill" },
            "style": {
              "background": "#0000ff",
              "radius": 20,
              "color": "#ffffff",
              "fontSize": 7,
              "align": "start"
            }
          },
          {
            "type": "spacer",
            "layout": { "width": 10, "height": "fill" },
            "style": { "background": "transparent" }
          },
          {
            "type": "text",
            "id": "text_tip2",
            "text": "Go,zhongxj",
            "layout": { "width": 100, "height": "fill" },
            "style": {
              "background": "#ff00ff",
              "radius": 20,
              "color": "#ffffff",
              "fontSize": 5,
              "align": "center"
            }
          },
          {
            "type": "spacer",
            "layout": { "width": 10, "height": "fill" }
          },
          {
            "type": "text",
            "id": "text_tip3",
            "text": "Go,XCY",
            "layout": { "width": 100, "height": "fill" },
            "style": {
              "background": "#ffff00",
              "radius": 20,
              "color": "#000000",
              "fontSize": 5,
              "align": "end"
            }
          }
        ]
      }
    ]
  },
  "events": {
    "showToast": {
      "action": "toast",
      "message": "$toastMsg"
    },
    "updateStyle": {
      "action": "setTextStyle",
      "target": "text_tip",
      "fontSize": 14,
      "color": "#CCCCCC",
      "text": "我改变了！！！！！"
    }
  }
}
